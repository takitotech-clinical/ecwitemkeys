{
	"name": "ecwitemkeys",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "eCW Item Keys Browser",
	"license": "UNLICENSED",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"dev": "pnpm data:build && vite dev",
		"build": "pnpm data:build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"data:build": "tsx scripts/build-data.ts",
		"data:check": "tsx scripts/check.ts",
		"data:sync": "tsx scripts/sync.ts",
		"data:adopt-additional": "tsx scripts/adopt-additional.ts",
		"data:add-column": "tsx scripts/columns.ts add",
		"data:rename-column": "tsx scripts/columns.ts rename",
		"data:remove-column": "tsx scripts/columns.ts remove",
		"gh:labels": "bash scripts/gh-labels.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	}
}
